# ============================================================================
# Leo Prime Firewall - Environment Configuration
# ============================================================================
#
# IMPORTANT: Never commit this file to version control!
# Use .env.local for development and .env.production for production
#
# ============================================================================
# REQUIRED CONFIGURATION
# ============================================================================

# NextDNS API Key (get from https://nextdns.io)
NEXTDNS_API_KEY=your_nextdns_api_key_here

# ============================================================================
# PRODUCTION CONFIGURATION (Required for production deployment)
# ============================================================================

# NextAuth Secret (generate with: openssl rand -base64 32)
# REQUIRED for authentication to work in production
NEXTAUTH_SECRET=generate-a-random-secret-key-with-openssl-rand-base64-32

# NextAuth URL (the public URL of your application)
# NEXTAUTH_URL=https://your-domain.com

# ============================================================================
# DATABASE CONFIGURATION (Optional, for future use)
# ============================================================================

# PostgreSQL Database URL
# Format: postgresql://user:password@host:port/database
# DATABASE_URL=postgresql://user:password@localhost:5432/leo_prime

# ============================================================================
# BUILD CONFIGURATION (Optional)
# ============================================================================

# Node environment
NODE_ENV=development

# Next.js distribution directory (default: .next)
# NEXT_DIST_DIR=.next

# Next.js output mode (default: standalone)
# NEXT_OUTPUT_MODE=standalone

# ============================================================================
# IMPORTANT SECURITY NOTES
# ============================================================================
#
# 1. NEVER commit secrets to version control
# 2. NEXTAUTH_SECRET: Generate a strong random string
#    Command: openssl rand -base64 32
# 3. Change NEXTAUTH_SECRET before production deployment
# 4. Store secrets securely (use environment variables, secret managers, etc.)
# 5. Review DEPLOYMENT.md for security best practices
#
# ============================================================================
